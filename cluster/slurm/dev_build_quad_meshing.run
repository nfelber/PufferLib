#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --partition=gpu
#SBATCH --qos=normal
#SBATCH --gres=gpu:1
#SBATCH --time=00:30:00
#SBATCH --job-name=puffer-quad-dev-build
#SBATCH --output=slurm-%x-%j.out

set -euo pipefail

IMAGE=${IMAGE:-$HOME/docker-images/pufferlib_quad_meshing_latest.sif}
SOURCE_DIR=${SOURCE_DIR:-$PWD}
OUTPUT_DIR=${OUTPUT_DIR:-$SOURCE_DIR/cluster_runs/dev}
ENV_NAME=${ENV_NAME:-quad_meshing}

mkdir -p "$OUTPUT_DIR" "$OUTPUT_DIR/cache"

export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export APPTAINERENV_XDG_CACHE_HOME=/outputs/cache
export APPTAINERENV_OMP_NUM_THREADS="$OMP_NUM_THREADS"
export APPTAINERENV_CC=/usr/bin/gcc
export APPTAINERENV_CXX=/usr/bin/g++
export APPTAINERENV_CUDAHOSTCXX=/usr/bin/g++
export APPTAINERENV_CPATH=/usr/lib/gcc/x86_64-linux-gnu/11/include
export APPTAINERENV_LIBRARY_PATH=/usr/local/cuda/lib64/stubs
export APPTAINERENV_TRITON_CACHE_DIR=/outputs/cache/triton
export SINGULARITYENV_CC=/usr/bin/gcc
export SINGULARITYENV_CXX=/usr/bin/g++
export SINGULARITYENV_CUDAHOSTCXX=/usr/bin/g++
export SINGULARITYENV_CPATH=/usr/lib/gcc/x86_64-linux-gnu/11/include
export SINGULARITYENV_LIBRARY_PATH=/usr/local/cuda/lib64/stubs
export SINGULARITYENV_TRITON_CACHE_DIR=/outputs/cache/triton

srun apptainer exec --nv \
    --bind "$SOURCE_DIR:/workspace/PufferLib" \
    --bind "$OUTPUT_DIR:/outputs" \
    "$IMAGE" \
    bash -lc "export CC=/usr/bin/gcc CXX=/usr/bin/g++ CUDAHOSTCXX=/usr/bin/g++ CPATH=/usr/lib/gcc/x86_64-linux-gnu/11/include LIBRARY_PATH=/usr/local/cuda/lib64/stubs TRITON_CACHE_DIR=/outputs/cache/triton && cd /workspace/PufferLib && NVCC_ARCH=sm_70 bash build.sh '$ENV_NAME' --float"
