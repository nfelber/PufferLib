#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --partition=gpu
#SBATCH --qos=normal
#SBATCH --gres=gpu:1
#SBATCH --time=1:00:00
#SBATCH --job-name=puffer-quad-train
#SBATCH --output=slurm-%x-%j.out

set -euo pipefail

IMAGE=${IMAGE:-$HOME/docker-images/pufferlib_quad_meshing_latest.sif}
WANDB_GROUP=${WANDB_GROUP:-quad_meshing_train}
WORKDIR=${WORKDIR:-$PWD}
OUTPUT_DIR=${OUTPUT_DIR:-$WORKDIR/cluster_runs}
PUFFER_ARGS=${PUFFER_ARGS:-}

mkdir -p "$OUTPUT_DIR" "$OUTPUT_DIR/checkpoints" "$OUTPUT_DIR/logs" "$OUTPUT_DIR/wandb" "$OUTPUT_DIR/cache"

export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export APPTAINERENV_WANDB_DIR=/outputs/wandb
export APPTAINERENV_WANDB_CACHE_DIR=/outputs/cache/wandb
export APPTAINERENV_XDG_CACHE_HOME=/outputs/cache
export APPTAINERENV_OMP_NUM_THREADS="$OMP_NUM_THREADS"
export APPTAINERENV_CC=/usr/bin/gcc
export APPTAINERENV_CXX=/usr/bin/g++
export APPTAINERENV_CUDAHOSTCXX=/usr/bin/g++
export APPTAINERENV_TRITON_CACHE_DIR=/outputs/cache/triton

srun apptainer exec --nv \
    --bind "$OUTPUT_DIR:/outputs" \
    "$IMAGE" \
    bash -lc "cd /workspace/PufferLib && puffer train quad_meshing --slowly --wandb --wandb-group '$WANDB_GROUP' --checkpoint-dir /outputs/checkpoints --log-dir /outputs/logs $PUFFER_ARGS"
