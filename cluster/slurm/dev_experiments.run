#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --partition=gpu
#SBATCH --qos=normal
#SBATCH --gres=gpu:1
#SBATCH --time=2:00:00
#SBATCH --job-name=puffer-experiment

set -euo pipefail

MANIFEST=${1:?Usage: dev_experiments.run MANIFEST SOURCE_DIR OUTPUT_DIR IMAGE}
SOURCE_DIR=${2:?Usage: dev_experiments.run MANIFEST SOURCE_DIR OUTPUT_DIR IMAGE}
OUTPUT_DIR=${3:?Usage: dev_experiments.run MANIFEST SOURCE_DIR OUTPUT_DIR IMAGE}
IMAGE=${4:?Usage: dev_experiments.run MANIFEST SOURCE_DIR OUTPUT_DIR IMAGE}
TASK_ID=${SLURM_ARRAY_TASK_ID:?Submit this script as a Slurm array}
TASK_CACHE="/outputs/cache/tasks/${SLURM_ARRAY_JOB_ID}_${TASK_ID}"

mkdir -p "$OUTPUT_DIR/checkpoints" "$OUTPUT_DIR/logs" \
    "$OUTPUT_DIR/wandb" "$OUTPUT_DIR/cache/tasks/${SLURM_ARRAY_JOB_ID}_${TASK_ID}"

export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export APPTAINERENV_WANDB_DIR=/outputs/wandb
export APPTAINERENV_WANDB_CACHE_DIR="$TASK_CACHE/wandb"
export APPTAINERENV_XDG_CACHE_HOME="$TASK_CACHE"
export APPTAINERENV_OMP_NUM_THREADS="$OMP_NUM_THREADS"
export APPTAINERENV_CC=/usr/bin/gcc
export APPTAINERENV_CXX=/usr/bin/g++
export APPTAINERENV_CUDAHOSTCXX=/usr/bin/g++
export APPTAINERENV_CPATH=/usr/lib/gcc/x86_64-linux-gnu/11/include
export APPTAINERENV_LIBRARY_PATH=/usr/local/cuda/lib64/stubs
export APPTAINERENV_TRITON_CACHE_DIR="$TASK_CACHE/triton"
export SINGULARITYENV_WANDB_DIR=/outputs/wandb
export SINGULARITYENV_WANDB_CACHE_DIR="$TASK_CACHE/wandb"
export SINGULARITYENV_XDG_CACHE_HOME="$TASK_CACHE"
export SINGULARITYENV_OMP_NUM_THREADS="$OMP_NUM_THREADS"
export SINGULARITYENV_CC=/usr/bin/gcc
export SINGULARITYENV_CXX=/usr/bin/g++
export SINGULARITYENV_CUDAHOSTCXX=/usr/bin/g++
export SINGULARITYENV_CPATH=/usr/lib/gcc/x86_64-linux-gnu/11/include
export SINGULARITYENV_LIBRARY_PATH=/usr/local/cuda/lib64/stubs
export SINGULARITYENV_TRITON_CACHE_DIR="$TASK_CACHE/triton"

srun apptainer exec --nv \
    --bind "$SOURCE_DIR:/workspace/PufferLib" \
    --bind "$OUTPUT_DIR:/outputs" \
    --bind "$MANIFEST:/tmp/puffer-experiments.json:ro" \
    "$IMAGE" \
    bash -lc "export CC=/usr/bin/gcc CXX=/usr/bin/g++ CUDAHOSTCXX=/usr/bin/g++ CPATH=/usr/lib/gcc/x86_64-linux-gnu/11/include LIBRARY_PATH=/usr/local/cuda/lib64/stubs TRITON_CACHE_DIR='$TASK_CACHE/triton' && cd /workspace/PufferLib && python -m pufferlib.experiments run /tmp/puffer-experiments.json --index '$TASK_ID' --output-dir /outputs"
