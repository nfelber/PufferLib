#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --partition=gpu
#SBATCH --qos=normal
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --job-name=puffer-quad-dev-sweep
#SBATCH --output=slurm-%x-%j.out

set -euo pipefail

IMAGE=${IMAGE:-$HOME/docker-images/pufferlib_quad_meshing_latest.sif}
SOURCE_DIR=${SOURCE_DIR:-$PWD}
OUTPUT_DIR=${OUTPUT_DIR:-$SOURCE_DIR/cluster_runs/dev}
WANDB_GROUP=${WANDB_GROUP:-quad_meshing_dev_sweep}
BUILD_BACKEND=${BUILD_BACKEND:-0}
GPUS=${GPUS:-${SLURM_GPUS_ON_NODE:-1}}
PUFFER_ARGS=${PUFFER_ARGS:-}

mkdir -p "$OUTPUT_DIR" "$OUTPUT_DIR/checkpoints" "$OUTPUT_DIR/logs" "$OUTPUT_DIR/wandb" "$OUTPUT_DIR/cache"

export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export APPTAINERENV_WANDB_DIR=/outputs/wandb
export APPTAINERENV_WANDB_CACHE_DIR=/outputs/cache/wandb
export APPTAINERENV_XDG_CACHE_HOME=/outputs/cache
export APPTAINERENV_OMP_NUM_THREADS="$OMP_NUM_THREADS"
export APPTAINERENV_CC=/usr/bin/gcc
export APPTAINERENV_CXX=/usr/bin/g++
export APPTAINERENV_CUDAHOSTCXX=/usr/bin/g++
export APPTAINERENV_TRITON_CACHE_DIR=/outputs/cache/triton

srun apptainer exec --nv \
    --bind "$SOURCE_DIR:/workspace/PufferLib" \
    --bind "$OUTPUT_DIR:/outputs" \
    "$IMAGE" \
    bash -lc "cd /workspace/PufferLib && if [ '$BUILD_BACKEND' = '1' ]; then NVCC_ARCH=sm_70 bash build.sh quad_meshing --float; fi && puffer sweep quad_meshing --slowly --wandb --wandb-group '$WANDB_GROUP' --sweep.gpus '$GPUS' --checkpoint-dir /outputs/checkpoints --log-dir /outputs/logs $PUFFER_ARGS"
